# Large / copyrighted PDFs and backups
*.pdf
*.pdf.backup

# Extracted page images (large, can be regenerated from PDFs)
assets/pdf_images/

# OCR raw outputs
data/ocr/

# Extracted TOC / QA pairs (can be regenerated from PDFs)
data/qa/
data/toc/

# Generated questions, reports and frontend bundles
output/
math-bank/data.js
math-bank/data-*.json
math-bank/data-*.json.gz
math-bank/data-*.js
math-bank/数据结构题库.html

# Python / tool caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/
tests/__pycache__/
.playwright-mcp/

# Backup / temp files
*.backup
*.bak
*.bak-*
*.old
*.log
*.pid

# Local screenshots / verification images
*.png
*.jpg
*.jpeg
# 但保留题目精准裁剪图（无原始版权内容）
!math-bank/crops/**/*.png
screenshots/
tmp/
temp/

# Deprecated / leftover directories
scripts_output/
archive/

# Local agent/editor settings
.claude/
